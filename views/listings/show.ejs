<% layout('/layouts/boilerplate') -%>

    <body>
        <div class="flex flex-col justify-center w-[70vw] mx-auto gap-6">
            <div class="flex flex-col justify-center items-center">
                <h2 class="text-2xl font-semibold mb-6">
                    <%= listing.title %>
                </h2>
                <div class="w-[70vw] mb-6">
                    <img class="w-full h-124 object-cover rounded-2xl" src="<%= listing.image.url %>" alt="">
                </div>
            </div>
            <div class="info flex flex-col gap-2 w-[70vw] mx-auto">
                <p><i>Owned by: <%= listing.owner.username %></i></p>
                <p class="font-semibold text-lg">
                    <%= listing.description %>
                </p>
                <p>&#8377;<%= listing.price.toLocaleString("en-IN") %>/night</p>
                <p>
                    <%= listing.location %>
                </p>
                <p>
                    <%= listing.country %>
                </p>
                <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
                    <div class="flex gap-3 mt-4">
                        <a href="/listings/<%= listing._id %>/edit"
                            class="bg-[#FF5A5F] text-white px-3 py-2 rounded-lg w-34 text-center">Edit this listing</a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button class="bg-black text-white px-3 py-2 rounded-lg w-34">Delete</button>
                        </form>
                    </div>
                    <% } %>
            </div>

            <hr>

            <% if(currUser) { %>
                <div class="info flex flex-col gap-2 w-[70vw] mx-auto">
                    <h3 class="text-xl font-semibold">Leave a Review</h3>
                    <form action="/listings/<%= listing.id %>/reviews" method="POST" class="flex flex-col gap-3"
                        id="form" novalidate>
                        <div class="rating flex flex-col gap-2  w-fit">
                            <label for="rating">Rating:</label>
                            <fieldset class="starability-basic">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                                    aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>


                        <div class="flex flex-col ">
                            <label for="comment">Write your feedback:</label>
                            <textarea class="border outline-none w-100 h-34 rounded-xl px-3 py-2" name="review[comment]"
                                id="comment" required></textarea>
                            <p class="invalid-feedback hidden text-red-600 text-sm mt-1">Leave a Comment!</p>
                        </div>

                        <button type="submit"
                            class="border w-fit px-4 py-1 rounded-lg cursor-pointer bg-black text-white">Submit</button>
                    </form>
                </div>
                <hr>
                <% } %>


                    <div class="flex flex-col gap-3">
                        <h3 class="text-xl font-semibold">All Reviews</h3>
                        <div class="flex gap-5 flex-wrap">
                            <% for(review of listing.reviews) { %>

                                <div class="card border rounded-xl w-[30vw] px-6 py-3">
                                    <div class="card-title font-semibold">@<%= review.author.username %>
                                        <p class="starability-result mb-5" data-rating="<%= review.rating %>"></p>
                                    </div>
                                    <div class="card-text flex items-center justify-between">
                                        <div class="card-text">
                                            <%= review.comment %>
                                        </div>
                                        <form
                                            action="/listings/<%= listing.id %>/reviews/<%= review._id %>?_method=DELETE"
                                            method="POST">
                                            <button class="flex justify-center items-center"><img class="h-5"
                                                    src="/images/bin.svg" alt=""></button>
                                        </form>
                                    </div>
                                </div>
                                <% } %>
                        </div>
                    </div>
        </div>
    </body>