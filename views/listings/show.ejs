<% layout('/layouts/boilerplate') -%>

<%
    const reviews = listing.reviews || [];
    const avgRating = reviews.length
        ? reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length
        : 0;
    const isOwner = currUser && listing.owner && listing.owner._id.equals(currUser._id);
%>

<script>
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
</script>

<div class="flex flex-col w-full max-w-5xl mx-auto gap-8">

    <!-- Title -->
    <div>
        <h2 class="text-2xl sm:text-3xl font-semibold"><%= listing.title %></h2>
        <p class="mt-2 text-sm text-gray-700 flex flex-wrap items-center gap-x-2">
            <% if (reviews.length > 0) { %>
                <span class="font-medium">&#9733; <%= avgRating.toFixed(1) %></span>
                <span>&middot;</span>
                <span class="underline"><%= reviews.length %> review<%= reviews.length === 1 ? "" : "s" %></span>
                <span>&middot;</span>
            <% } %>
            <span class="underline"><%= listing.location %>, <%= listing.country %></span>
        </p>
    </div>

    <!-- Image -->
    <div class="w-full">
        <img class="w-full h-64 sm:h-96 lg:h-[30rem] object-cover rounded-2xl bg-gray-100"
            src="<%= listing.image && listing.image.url ? listing.image.url : '' %>" alt="<%= listing.title %>">
    </div>

    <!-- Details + price card -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="info lg:col-span-2 flex flex-col gap-6">
            <div class="pb-6 border-b border-gray-200">
                <h3 class="text-xl font-semibold">
                    <%= listing.location %>, <%= listing.country %>
                </h3>
                <p class="mt-2 text-gray-600 flex items-center gap-3">
                    <span class="h-10 w-10 rounded-full bg-gray-900 text-white flex items-center justify-center uppercase font-medium">
                        <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0) : "?" %>
                    </span>
                    <span>
                        <span class="block font-medium text-gray-900">
                            Hosted by <%= listing.owner ? listing.owner.username : "Unknown" %>
                        </span>
                        <span class="text-sm">Owner of this listing</span>
                    </span>
                </p>
            </div>

            <div class="pb-6 border-b border-gray-200">
                <h3 class="text-xl font-semibold mb-3">About this place</h3>
                <p class="text-gray-700 leading-relaxed whitespace-pre-line"><%= listing.description %></p>
            </div>

            <% if (isOwner) { %>
                <div class="flex flex-wrap gap-3">
                    <a href="/listings/<%= listing._id %>/edit"
                        class="bg-[#FF385C] hover:bg-[#E31C5F] text-white font-medium px-5 py-2.5 rounded-xl text-center transition-colors">
                        Edit this listing
                    </a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"
                        onsubmit="return confirm('Delete this listing? This cannot be undone.');">
                        <button class="bg-gray-900 hover:bg-black text-white font-medium px-5 py-2.5 rounded-xl cursor-pointer transition-colors">
                            Delete
                        </button>
                    </form>
                </div>
            <% } %>
        </div>

        <aside class="lg:col-span-1">
            <div class="lg:sticky lg:top-24 border border-gray-200 rounded-2xl shadow-lg p-6">
                <div class="flex items-end justify-between">
                    <p>
                        <span class="text-2xl font-semibold">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                        <span class="text-gray-600"> night</span>
                    </p>
                    <% if (reviews.length > 0) { %>
                        <p class="text-sm font-medium">&#9733; <%= avgRating.toFixed(1) %>
                            <span class="text-gray-500 font-normal">(<%= reviews.length %>)</span>
                        </p>
                    <% } %>
                </div>
                <hr class="my-4 border-gray-200">
                <ul class="text-sm text-gray-700 space-y-2">
                    <li class="flex justify-between"><span>Location</span><span class="font-medium text-right"><%= listing.location %></span></li>
                    <li class="flex justify-between"><span>Country</span><span class="font-medium text-right"><%= listing.country %></span></li>
                    <li class="flex justify-between"><span>Host</span><span class="font-medium text-right"><%= listing.owner ? listing.owner.username : "Unknown" %></span></li>
                </ul>
            </div>
        </aside>
    </div>

    <hr class="border-gray-200">

    <!-- Leave a review -->
    <% if (currUser) { %>
        <div class="info flex flex-col gap-3 max-w-2xl">
            <h3 class="text-xl font-semibold">Leave a Review</h3>
            <form action="/listings/<%= listing.id %>/reviews" method="POST" class="flex flex-col gap-4" id="form" novalidate>
                <div class="rating flex flex-col gap-2 w-fit">
                    <label for="rating" class="text-sm font-medium">Rating:</label>
                    <fieldset class="starability-basic">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                            checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="flex flex-col">
                    <label for="comment" class="text-sm font-medium mb-1.5">Write your feedback:</label>
                    <textarea
                        class="w-full h-32 rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:border-black focus:ring-2 focus:ring-black/10"
                        name="review[comment]" id="comment" placeholder="Share your experience with future guests" required></textarea>
                    <p class="invalid-feedback hidden text-red-600 text-sm mt-1">Leave a Comment!</p>
                </div>

                <button type="submit"
                    class="w-fit px-6 py-2.5 rounded-xl cursor-pointer bg-[#FF385C] hover:bg-[#E31C5F] text-white font-medium transition-colors">
                    Submit
                </button>
            </form>
        </div>
        <hr class="border-gray-200">
    <% } else { %>
        <div class="bg-gray-50 border border-gray-200 rounded-2xl px-6 py-5 text-gray-700">
            <a href="/login" class="font-medium text-black underline">Log in</a> to leave a review for this listing.
        </div>
    <% } %>

    <!-- Reviews -->
    <% if (reviews.length > 0) { %>
        <div class="flex flex-col gap-5">
            <h3 class="text-xl font-semibold">
                &#9733; <%= avgRating.toFixed(1) %> &middot; <%= reviews.length %> review<%= reviews.length === 1 ? "" : "s" %>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <% for (let review of reviews) { %>
                    <div class="card border border-gray-200 rounded-2xl p-5 flex flex-col gap-3">
                        <div class="flex items-center gap-3">
                            <span class="h-10 w-10 rounded-full bg-gray-900 text-white flex items-center justify-center uppercase font-medium">
                                <%= review.author && review.author.username ? review.author.username.charAt(0) : "?" %>
                            </span>
                            <div class="card-title font-semibold">
                                @<%= review.author ? review.author.username : "deleted-user" %>
                            </div>
                        </div>
                        <p class="starability-result" data-rating="<%= review.rating %>"></p>
                        <div class="flex items-start justify-between gap-4">
                            <div class="card-text text-gray-700"><%= review.comment %></div>
                            <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                <form action="/listings/<%= listing.id %>/reviews/<%= review._id %>?_method=DELETE" method="POST"
                                    onsubmit="return confirm('Delete this review?');">
                                    <button class="flex justify-center items-center p-2 rounded-full hover:bg-gray-100 cursor-pointer" aria-label="Delete review">
                                        <img class="h-5" src="/images/bin.svg" alt="">
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
        <hr class="border-gray-200">
    <% } %>

    <!-- Map -->
    <div class="flex flex-col gap-4 w-full">
        <h2 class="text-xl font-semibold">Where you'll be</h2>
        <p class="text-gray-600 -mt-2"><%= listing.location %>, <%= listing.country %></p>
        <div id="map" class="h-80 sm:h-[30rem] w-full rounded-2xl"></div>
    </div>
</div>
