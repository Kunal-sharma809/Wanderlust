<% layout('/layouts/boilerplate') -%>

<div class="flex items-end justify-between mb-8">
    <div>
        <h2 class="text-2xl sm:text-3xl font-semibold">All Listings</h2>
        <p class="text-gray-500 mt-1"><%= allListings.length %> place<%= allListings.length === 1 ? "" : "s" %> to stay</p>
    </div>
    <a href="/listings/new"
        class="hidden sm:inline-block bg-[#FF385C] hover:bg-[#E31C5F] text-white font-medium px-5 py-2.5 rounded-xl transition-colors">
        Add a listing
    </a>
</div>

<% if (allListings.length === 0) { %>
    <div class="text-center py-24 border border-dashed border-gray-300 rounded-2xl">
        <h3 class="text-xl font-semibold">No listings yet</h3>
        <p class="text-gray-500 mt-2">Be the first to host a place on Wanderlust.</p>
        <a href="/listings/new" class="inline-block mt-6 bg-[#FF385C] text-white px-5 py-2.5 rounded-xl">Create a listing</a>
    </div>
<% } else { %>
    <div class="cardsContainer grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-10">
        <% for (let listing of allListings) { %>
            <a href="/listings/<%= listing._id %>" class="card group block">
                <div class="aspect-square overflow-hidden rounded-2xl bg-gray-100">
                    <img class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
                        src="<%= listing.image && listing.image.url ? listing.image.url : '' %>"
                        alt="<%= listing.title %>" loading="lazy">
                </div>
                <div class="mt-3 space-y-0.5">
                    <p class="font-semibold truncate"><%= listing.location %>, <%= listing.country %></p>
                    <p class="text-gray-500 truncate"><%= listing.title %></p>
                    <p class="pt-1">
                        <span class="font-semibold">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                        <span class="text-gray-600">night</span>
                    </p>
                </div>
            </a>
        <% } %>
    </div>
<% } %>
